# Example environment for scripts/yrka/deploy-yrka.ts — names and placeholders only.
# Copy to scripts/yrka/yrka.env (gitignored via `scripts/yrka/yrka.env` in .gitignore),
# chmod 600, fill in, then:
#   set -a; source scripts/yrka/yrka.env; set +a
#   node scripts/yrka/deploy-yrka.ts plan     # dry-run, touches no network
#   node scripts/yrka/deploy-yrka.ts deploy  # the real thing
#
# Never commit filled-in values. Wrangler and this script print secret NAMES only.

# --- required -------------------------------------------------------------------------

# Cloudflare API token with Workers Scripts Edit, KV Edit, R2 Edit on the yrka account.
CLOUDFLARE_API_TOKEN=

# The deployment's admin usernames/emails, comma-separated (the /admin panel's gate). Password
# mode matches the username; Cloudflare Access mode matches the Access identity's email exactly
# (the backend keys users by the verified JWT email, and #isAdmin() compares that email to these
# entries, ASCII case-insensitively) — so in Access mode list the emails the Access application
# authenticates, not local usernames.
YRKA_ADMINS=

# --- optional: target and origin ------------------------------------------------------

# Defaults to the yrka account id baked into scripts/yrka/yrka-config.ts. The jami-studio
# account id is refused outright; any other override additionally needs
# YRKA_ALLOW_OTHER_ACCOUNT=i-know-what-i-am-doing.
#YRKA_ACCOUNT_ID=

# The public origin. With neither set, deploy reads the account's workers.dev subdomain from
# the API and uses https://router.<subdomain>.workers.dev. Set YRKA_PUBLIC_BASE_URL to a custom
# domain instead and the generated router config attaches that hostname to the router (a
# custom_domain route; the router keeps its workers.dev URL). Out of band, first: the DNS
# record exists and the hostname is not still attached to another worker (wrangler refuses an
# in-use attachment — detach the old one via the Workers Domains API first).
#YRKA_PUBLIC_BASE_URL=
#YRKA_WORKERS_DEV_HOST=

# --- optional: gatekeeper set ----------------------------------------------------------

# Comma-separated subset of packages/gatekeeper-*. Default:
#   gatekeeper-context,gatekeeper-scheduler,gatekeeper-mcp,gatekeeper-mcp-portal
# Refused outright: gatekeeper-websearch (spends Cloudflare AI Gateway credits per search —
# this fork never uses AI Gateway), gatekeeper-email (needs a zone).
# Adding gatekeeper-google also deploys the pdf-renderer internal worker it binds.
#YRKA_GATEKEEPERS=

# --- optional: Cloudflare Access sign-in -----------------------------------------------

# With both set, the deployment authenticates via Cloudflare Access (the frontend builds with
# VITE_CF_ACCESS_MODE=true, the backend gets CF_ACCESS_AUD/CF_ACCESS_ISS as secrets, and local
# password login/signup is refused outright — not kept as a fallback). With neither, username/
# password login is the mode. Either alone verifies nothing. In Access mode YRKA_ADMINS must
# list the Access identity emails (see above). The values come from the Access application:
# AUD is the app's aud (Access API), ISS is the team's https://<team>.cloudflareaccess.com.
#YRKA_CF_ACCESS_AUD=
#YRKA_CF_ACCESS_ISS=

# --- optional: OAuth app credentials, per installed gatekeeper -------------------------
# Pattern: YRKA_<VENDOR>_CLIENT_ID / YRKA_<VENDOR>_CLIENT_SECRET where VENDOR is the package
# name minus "gatekeeper-", uppercase, hyphens as underscores. Extras: MICROSOFT_TENANT_ID
# (secret), GITLAB_URL (a var; rides the same stdin channel). A gatekeeper listed in
# YRKA_GATEKEEPERS with no pair deploys unconfigured — connecting it fails until the pair is
# uploaded — and the deploy warns rather than fails. A half pair (id without secret or the
# reverse) fails the deploy: one OAuth app, never half of one.
#YRKA_GITHUB_CLIENT_ID=
#YRKA_GITHUB_CLIENT_SECRET=
#YRKA_GOOGLE_CLIENT_ID=
#YRKA_GOOGLE_CLIENT_SECRET=
#YRKA_MICROSOFT_CLIENT_ID=
#YRKA_MICROSOFT_CLIENT_SECRET=
#YRKA_MICROSOFT_TENANT_ID=
#YRKA_SLACK_CLIENT_ID=
#YRKA_SLACK_CLIENT_SECRET=
#YRKA_GITLAB_CLIENT_ID=
#YRKA_GITLAB_CLIENT_SECRET=
#YRKA_GITLAB_URL=
#YRKA_NOTION_CLIENT_ID=
#YRKA_NOTION_CLIENT_SECRET=
#YRKA_X_CLIENT_ID=
#YRKA_X_CLIENT_SECRET=
#YRKA_PAGERDUTY_CLIENT_ID=
#YRKA_PAGERDUTY_CLIENT_SECRET=
#YRKA_CLOUDFLARE_OAUTH_CLIENT_ID=
#YRKA_CLOUDFLARE_OAUTH_CLIENT_SECRET=
#YRKA_CONFLUENCE_CLIENT_ID=
#YRKA_CONFLUENCE_CLIENT_SECRET=
#YRKA_LINEAR_CLIENT_ID=
#YRKA_LINEAR_CLIENT_SECRET=
#YRKA_SPOTIFY_CLIENT_ID=
#YRKA_SPOTIFY_CLIENT_SECRET=
#YRKA_SUPABASE_CLIENT_ID=
#YRKA_SUPABASE_CLIENT_SECRET=
#YRKA_ZOOMINFO_CLIENT_ID=
#YRKA_ZOOMINFO_CLIENT_SECRET=

# --- NOT a deployment secret: the model gateway -----------------------------------------
# gateway.yrka.io is NOT wired through worker secrets. AI Gateway mode is off on this
# deployment, so models are per-user settings in the Workshop UI (Settings -> Models): each
# user adds the chat models under the "Ollama" provider with
#   API URL:  https://gateway.yrka.io
#   API key:  <the user's gateway.yrka.io key>
#   Model:    cf-jami-zai-org-glm-5-3   (cf-jami-* first; cf-yrka-* on rate limit;
#             nv-* only as last resort; never ne-* — not on this gateway)
# See the deploy-prep report for the full model wiring plan. The gateway key is handed to
# users out of band, never stored in a Worker env.
